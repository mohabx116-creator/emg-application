# Set required values in your approved secret store or local ignored .env.
POSTGRES_PASSWORD=
JWT_KEY=
EMG_DOMAIN=emg-juzor.online
CORS_ORIGIN=https://emg-juzor.online
DATABASE_APPLY_MIGRATIONS=false
DATAPROTECTION_PERSIST_KEYS=true
# Set to the verified Docker host-bridge address; this VPS uses 172.16.0.1.
FORWARDED_HEADERS_TRUSTED_PROXY=172.16.0.1
# Optional for a local HTTP rehearsal; production should use the HTTPS domain above.
VITE_APP_API_URL=/
BACKUP_AGE_RECIPIENT=
BACKUP_DESTINATION=
